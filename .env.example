# Configuration and environment template for Grizzly SMS MyJio automation
# Copy this file to .env and fill in your Grizzly SMS API Key.

# Your Grizzly SMS API Key (from https://grizzlysms.com/profile/settings)
GRIZZLY_API_KEY=your_api_key_here

# Service code for MyJio in Grizzly SMS (jio = MyJio, jii = Jio)
GRIZZLY_SERVICE=jio

# Country code for India (default: 22)
GRIZZLY_COUNTRY=22

# Max price in USD (e.g. 0.3)
GRIZZLY_MAX_PRICE=0.3

# ---------------------------------------------------------------------------
# Target Jio Prefixes Configuration
# ---------------------------------------------------------------------------
# You can select a preset via PREFIX_PRESET, or customize TARGET_PREFIXES.
# Available presets: tier1 (strict), tier2 (popular), tier3 (all)
# PREFIX_PRESET=popular

# Option 1: Tier 1 (Strict / Default - 5 prefixes)
# Primary nationwide Jio-exclusive allocations (highest guarantee for promos)
TARGET_PREFIXES=600,939,700,701,702

# Option 2: Tier 2 (Popular / Moderate - 35 prefixes)
# Appends widespread 6-series, 70x/79x series, and 93x Jio LTE series:
# 6-series  : 620, 626, 628, 629, 630, 635, 636, 637, 638, 639
# 7-series  : 703, 704, 705, 706, 707, 708, 709, 790, 797, 798, 799
# 93-series : 930, 931, 932, 933, 934, 935, 936, 937, 938
# TARGET_PREFIXES=600,939,700,701,702,620,626,628,629,630,635,636,637,638,639,703,704,705,706,707,708,709,790,797,798,799,930,931,932,933,934,935,936,937,938

# Option 3: Tier 3 (Extended / All Known Jio Allocations - 82 prefixes)
# Appends 92-series (Reliance CDMA to LTE), 74x/75x/76x/78x circles, and 8-series Jio LTE blocks:
# 92-series : 920, 921, 922, 923, 924, 925, 926, 927, 928, 929
# 7-series  : 740, 741, 742, 750, 751, 752, 760, 761, 762, 763, 764, 765, 766, 767, 786, 787, 788, 789
# 8-series  : 821, 822, 824, 827, 828, 829, 843, 844, 846, 847, 848, 849, 877, 878, 879, 896, 897, 898, 899
# TARGET_PREFIXES=600,939,700,701,702,620,626,628,629,630,635,636,637,638,639,703,704,705,706,707,708,709,790,797,798,799,930,931,932,933,934,935,936,937,938,920,921,922,923,924,925,926,927,928,929,740,741,742,750,751,752,760,761,762,763,764,765,766,767,786,787,788,789,821,822,824,827,828,829,843,844,846,847,848,849,877,878,879,896,897,898,899

# Number of virtual number requests per attempt (default: 2)
# If multiple numbers match the target prefixes, they are queued for sequential testing.
BATCH_SIZE=2

# Initiate batch requests simultaneously in parallel (true/false, default: true)
PARALLEL_REQUESTS=true

# Delay between attempts in seconds to prevent rate limiting (do not harsh)
RETRY_DELAY=4

# Cooldown delay in seconds before cancelling discarded numbers on Grizzly SMS (default: 120 / 2 min)
CLEANUP_DELAY=120

# Maximum number of retry attempts to find the matching prefix (0 for unlimited / forever)
MAX_RETRIES=0

# Timeout waiting for SMS OTP in seconds (default: 1200 / 20 min, or 0 for unlimited until Enter/cancel)
SMS_TIMEOUT=1200

# HTTP request timeout in seconds for Grizzly SMS API calls (increase if seeing read timeout)
REQUEST_TIMEOUT=60

# Start automator in paused mode, waiting for user resume signal (via Telegram or terminal)
START_PAUSED=false


# ---------------------------------------------------------------------------
# Telegram Notifications Configuration
# ---------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather on Telegram, e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID or Channel ID (can be retrieved via python3 grizzly_myjio.py --get-chat-id)
TELEGRAM_CHAT_ID=

# Forward all terminal console log messages to Telegram (true/false, default: false)
# When false (recommended), only matched numbers with interactive command buttons, OTPs, and action alerts are sent.
# When true, all raw terminal log lines are mirrored to Telegram.
TELEGRAM_ALL_MESSAGES=false

# Send Telegram messages silently without notification sound (true/false, default: false)
TELEGRAM_SILENT=false


